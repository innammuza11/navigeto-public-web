{
  "name": "public-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .netlify",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/app/api/visa/route.test.ts src/lib/*.test.ts",
    "brand:generate": "node scripts/brand-tokens.mjs",
    "brand:check": "node scripts/brand-tokens.mjs --check"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
